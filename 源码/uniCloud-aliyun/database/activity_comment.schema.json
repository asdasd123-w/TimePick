{
  "bsonType": "object",
  "required": ["activity_id", "user_id", "content"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "description": "评论ID" },
    "activity_id": { "bsonType": "string", "title": "活动ID" },
    "user_id": { "bsonType": "string", "title": "用户ID" },
    "content": { "bsonType": "string", "title": "评论内容" },
    "image": { "bsonType": "string", "title": "评论图片URL", "defaultValue": "" },
    "created_at": { "bsonType": "timestamp", "title": "创建时间" }
  }
}
