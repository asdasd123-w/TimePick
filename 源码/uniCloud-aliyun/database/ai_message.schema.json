{
  "bsonType": "object",
  "required": ["conversation_id", "role", "content"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "description": "消息ID" },
    "conversation_id": { "bsonType": "string", "title": "所属会话ID", "foreignKey": "ai_conversation._id" },
    "role": { "bsonType": "string", "title": "角色", "enum": ["user", "assistant", "system"] },
    "content": { "bsonType": "string", "title": "消息内容" },
    "tokens": { "bsonType": "int", "title": "消耗token数", "defaultValue": 0 },
    "created_at": { "bsonType": "timestamp", "title": "创建时间" }
  }
}
