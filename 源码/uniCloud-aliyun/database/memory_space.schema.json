{
  "bsonType": "object",
  "required": ["user_id", "name"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "description": "空间ID" },
    "user_id": { "bsonType": "string", "title": "所属用户ID", "foreignKey": "user._id" },
    "name": { "bsonType": "string", "title": "空间名称", "trim": "both", "maxLength": 100 },
    "description": { "bsonType": "string", "title": "空间描述", "maxLength": 500, "defaultValue": "" },
    "cover": { "bsonType": "string", "title": "封面URL", "maxLength": 500, "defaultValue": "" },
    "theme": { "bsonType": "string", "title": "主题风格", "maxLength": 50, "defaultValue": "" },
    "is_public": { "bsonType": "int", "title": "是否公开: 0私有 1公开", "enum": [0, 1], "defaultValue": 0 },
    "created_at": { "bsonType": "timestamp", "title": "创建时间" },
    "updated_at": { "bsonType": "timestamp", "title": "更新时间" }
  }
}
