{
  "bsonType": "object",
  "required": ["user_id", "type", "content"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "description": "反馈ID" },
    "user_id": { "bsonType": "string", "title": "反馈用户ID", "foreignKey": "user._id" },
    "type": { "bsonType": "int", "title": "类型: 1建议 2bug 3其他", "enum": [1, 2, 3] },
    "content": { "bsonType": "string", "title": "反馈内容" },
    "contact": { "bsonType": "string", "title": "联系方式(可空)", "maxLength": 100, "defaultValue": "" },
    "status": { "bsonType": "int", "title": "状态: 0待处理 1已处理", "enum": [0, 1], "defaultValue": 0 },
    "reply": { "bsonType": "string", "title": "官方回复", "defaultValue": "" },
    "created_at": { "bsonType": "timestamp", "title": "反馈时间" },
    "updated_at": { "bsonType": "timestamp", "title": "更新时间" }
  }
}
