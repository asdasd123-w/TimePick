# ============================================================
# 拾光 TimePick 环境变量示例
#
# 用法：把本文件复制到「源码」根目录，重命名为 .env.local，按需填写。
#   Windows:      copy 环境变量示例.env ..\源码\.env.local
#   macOS/Linux:  cp 环境变量示例.env ../源码/.env.local
#
# ★ 源码根目录另有一份内容完全相同的 .env.example，随源码一起提供，
#   直接 cp .env.example .env.local 效果一样。两份文件请保持同步。
#
# 后端启动时会自己读取 .env.local，再读取 .env；
# 容器/部署平台注入的同名环境变量优先级最高（不会被文件覆盖）。
#
# ★ 本文件只放占位符，不含任何真实密钥，可以安全地提交到仓库。
#   填写后的 .env.local 已在 .gitignore 中，不会被提交。
# ============================================================

# ---------- 必填 ----------

# 登录令牌的签名密钥：随便一串随机字符，建议 32 位以上。
# 不配也能启动，但重启后所有用户都要重新登录。
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请替换成一串随机字符_建议32位以上

# 超级管理员用户名（就是注册时用的手机号）。
# 这个账号不可被删除、不可被禁用、不可被取消管理员身份、密码不可被重置，
# 且只有它能管理其他管理员和 AI 密钥。
# ★ 必须填，代码里不再提供默认值：不填则超管功能全部不可用（启动日志会提示）。
SUPER_ADMIN_USERNAME=请填你自己的注册手机号

# 注册口令：新用户注册时要输入的暗号。不填默认「优乐美」，建议自己改。
REGISTER_PASSPHRASE=请设置一个只有你知道的口令

# ---------- AI 能力（留空则对应功能关闭，不影响其他功能）----------

# DeepSeek · 文字：生成记忆标题（≤4 字）、AI 润色、小橘 AI 对话、封面画面描述
DEEPSEEK_API_KEY=sk-填你自己的DeepSeek密钥

# 智谱 · 生图：AI 记忆封面（CogView）
ZHIPU_API_KEY=填你自己的智谱密钥

# 阿里云百炼（万相）· 视频与语音：图生视频、语音合成（TTS）、录音转文字（ASR）
# 同一把密钥同时驱动「摆件语义检索」与「记忆语义搜索」的文本向量模型
# （text-embedding-v3）；不填则两者自动退回字面/关键词检索，功能不中断。
DASHSCOPE_API_KEY=sk-填你自己的阿里云百炼密钥

# ---------- 业务配置（一般不用改）----------

# 后端端口。默认 8787；被占用时改这里
PORT=8787

# 数据库文件路径。默认 server/data/timepick.db
# DB_PATH=server/data/timepick.db

# 数据库驱动：better-sqlite3 | node:sqlite | wasm
# 不填则按 better-sqlite3 → node:sqlite → wasm 的顺序自动选择。
# node:sqlite 是 Node 22 内置模块，不需要编译；Node 20 及更早请留空或写 wasm。
# DB_DRIVER=node:sqlite

# 每个用户每天最多生成几条 AI 视频 / 封面 / 对话
AI_DAILY_VIDEO_LIMIT=10
AI_DAILY_COVER_LIMIT=20
AI_DAILY_CHAT_LIMIT=200

# ---------- 模型与接口地址（一般不用改）----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_IMAGE_MODEL=cogview-3-flash
ZHIPU_IMAGE_SIZE=1344x768
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_I2V_MODEL=wan2.2-i2v-flash

# ---------- 前端 ----------

# 前端请求后端的地址。
# 生产/单端口模式写 /api（同源，自动跟着域名走）；
# 开发模式（npm run dev 与后端分开跑）写 http://localhost:8787/api
VITE_CLOUD_API_BASE=/api
