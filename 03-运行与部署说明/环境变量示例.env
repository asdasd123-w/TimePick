# ============================================================
# 拾光 TimePick 环境变量示例
#
# 用法：把本文件复制到「01-网站源码-前端与后端」根目录，重命名为 .env.local
#       Windows:  copy 环境变量示例.env ..\01-网站源码-前端与后端\.env.local
#       macOS/Linux: cp 环境变量示例.env ../01-网站源码-前端与后端/.env.local
#
# 后端启动时自己会读 .env.local，然后读 .env；系统环境变量优先级最高。
# ★ 这份文件里没有真实密钥（上一版误把真实密钥写进来了，已全部替换成占位符），
#   请填你自己的；填完记得不要把带真密钥的文件提交到仓库。
# ============================================================

# ---------- 必填 ----------
# 登录令牌的签名密钥。随便一串随机字符，建议 32 位以上。
# 不配也能启动，但重启后所有用户都要重新登录。
JWT_SECRET=请替换成一串随机字符_建议32位以上

# ---------- AI 能力（留空则对应功能关闭，不影响其他功能）----------

# DeepSeek · 文字：生成记忆标题（≤4 字）、AI 润色、小橘 AI 对话、封面画面描述
DEEPSEEK_API_KEY=sk-填你自己的DeepSeek密钥

# 智谱 · 生图：AI 记忆封面（CogView）
ZHIPU_API_KEY=填你自己的智谱密钥

# 阿里云百炼（万相）· 视频与语音：图生视频、录音转文字（ASR）
DASHSCOPE_API_KEY=sk-填你自己的阿里云百炼密钥

# ---------- 业务配置 ----------

# 超级管理员（注册时的手机号）。这个账号不可被删除、不可被禁用、
# 不可被取消管理员身份、密码不可被重置，且只有它能管理 AI 密钥。
SUPER_ADMIN_USERNAME=13800138000

# 注册口令：不填默认「优乐美」
REGISTER_PASSPHRASE=优乐美

# 后端端口。默认 8787；被占用时改这里
PORT=8787

# 每个用户每天最多生成几条 AI 视频
AI_DAILY_VIDEO_LIMIT=10

# ---------- 模型与接口地址（一般不用改）----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_IMAGE_MODEL=cogview-3-flash
ZHIPU_IMAGE_SIZE=1344x768
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_I2V_MODEL=wan2.2-i2v-flash

# 前端请求后端的地址。
# 生产/单端口模式写 /api（同源，自动跟着域名走）；
# 开发模式（npm run dev + npm run server 分开跑）写 http://localhost:8787/api
VITE_CLOUD_API_BASE=/api
